          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard"
          ]
        }
      }
    },
    {
      "name": "Dashboard With Filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard?city=Mumbai&category=Electronics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
